# 카츠랭 환경변수 템플릿
# 실제 값을 채워서 .env 파일을 만들고 사용하세요.
# .env 파일은 절대 커밋 금지 (.gitignore에 포함되어 있음)

# =========================================
# 카카오 OAuth (로그인용)
# https://developers.kakao.com 에서 발급
# =========================================
KAKAO_CLIENT_ID=your_kakao_client_id_here
KAKAO_CLIENT_SECRET=your_kakao_client_secret_here

# =========================================
# 카카오 로컬 검색 API (가게 검색용)
# 같은 카카오 디벨로퍼스 앱의 REST API 키
# =========================================
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# =========================================
# 데이터베이스 (로컬은 docker-compose 기본값)
# =========================================
DB_URL=jdbc:postgresql://localhost:5432/katsurank
DB_USERNAME=katsurank
DB_PASSWORD=katsurank_local
